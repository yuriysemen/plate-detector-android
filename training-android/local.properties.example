## Copy this file to local.properties and fill in your own values.
## local.properties is gitignored — never commit it.

# Location of the Android SDK. This is only used by Gradle.
sdk.dir=/path/to/Android/sdk

# AWS / Cognito configuration — copy values from `sam deploy` outputs (see ../infra/aws/README.md).
# Optional: these can instead be left blank here and entered on-device via Settings ->
# "Backend configuration" after install (REQ-032) — useful for a generic APK shared with testers.
COGNITO_USER_POOL_ID=<region>_<pool-id>
COGNITO_APP_CLIENT_ID=<app-client-id>
COGNITO_IDENTITY_POOL_ID=<region>:<identity-pool-uuid>
UPLOAD_SERVICE_URL=<api-gateway-invoke-url>

# Optional: personal access token (repo read scope) to download the bundled
# default model from a private GitHub Releases repo at build time.
# MODEL_DOWNLOAD_TOKEN=ghp_<your_personal_access_token>
