## Copy this file to local.properties and fill in your own values.
## local.properties is gitignored — never commit it.

# Location of the Android SDK. This is only used by Gradle.
sdk.dir=/path/to/Android/sdk

# AWS / Cognito configuration — same backend as the main app (../android/local.properties).
# COGNITO_* copied from the shared PlateDetectorUsers pool; DATASET_BUCKET_NAME is the
# dataset bucket from infra/aws/samconfig.toml. AWS region is derived at runtime from the
# COGNITO_IDENTITY_POOL_ID prefix, so no separate region key is needed.
COGNITO_USER_POOL_ID=<region>_<pool-id>
COGNITO_APP_CLIENT_ID=<app-client-id>
COGNITO_IDENTITY_POOL_ID=<region>:<identity-pool-uuid>
DATASET_BUCKET_NAME=<dataset-bucket-name>
